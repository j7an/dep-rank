{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.j7an/dep-rank",
  "title": "dep-rank",
  "description": "Rank a GitHub repo's dependents by stars or trust heuristic, and search their code",
  "version": "0.0.0",
  "repository": { "url": "https://github.com/j7an/dep-rank", "source": "github" },
  "packages": [
    {
      "registryType": "pypi",
      "identifier": "dep-rank",
      "version": "0.0.0",
      "runtimeHint": "uvx",
      "runtimeArguments": [
        { "type": "positional", "value": "--with", "isRequired": true },
        { "type": "positional", "value": "dep-rank[mcp]", "isRequired": true }
      ],
      "packageArguments": [
        { "type": "positional", "value": "mcp", "isRequired": true }
      ],
      "transport": { "type": "stdio" },
      "environmentVariables": [
        {
          "name": "DEP_RANK_TOKEN",
          "description": "GitHub token (required) for dependents scraping, trust metadata, and code search",
          "isRequired": true,
          "isSecret": true
        }
      ]
    }
  ]
}
